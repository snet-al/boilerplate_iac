# =============================================================================
# BACKUP CONFIGURATION - PRODUCTION
# =============================================================================
# Production environment backup configuration
# Copy this file to ../backup.prod.env and customize for your environment
# =============================================================================

# -----------------------------------------------------------------------------
# BACKUP SETTINGS
# -----------------------------------------------------------------------------
# Which database to backup (postgres|mysql|mongo|none)
BACKUP_DATABASE="postgres"

# Backup directory (relative to project root)
BACKUP_DIR="./backups/data"

# Backup type: auto, daily, weekly, monthly
# auto - Automatically determines type based on day (recommended)
#   - Daily: Every day
#   - Weekly: Every Sunday
#   - Monthly: First day of month
BACKUP_TYPE="auto"

# Retention policy (how many to keep)
DAILY_RETENTION=7      # Keep last 7 daily backups
WEEKLY_RETENTION=8     # Keep last 8 weekly backups (2 months)
MONTHLY_RETENTION=12   # Keep last 12 monthly backups (1 year)

# -----------------------------------------------------------------------------
# CONNECTION TYPE
# -----------------------------------------------------------------------------
# How to connect to the database: "docker" or "host"
CONNECTION_TYPE="docker"

# -----------------------------------------------------------------------------
# DOCKER CONNECTION (when CONNECTION_TYPE="docker")
# -----------------------------------------------------------------------------
ENVIRONMENT="prod"
CONTAINER="prod_postgres"

# -----------------------------------------------------------------------------
# HOST CONNECTION (when CONNECTION_TYPE="host")
# -----------------------------------------------------------------------------
# For remote host or localhost connections
DB_HOST="db.production.example.com"
DB_PORT="5432"

# Docker image to use for host connections (optional)
# Can be a full image name OR a service name
# If not set, will use: postgres:16, mysql:8.0, or mongo:7
DB_IMAGE=""
# Examples (full image):
#   DB_IMAGE="postgres:15"
#   DB_IMAGE="mysql:8.0.35"
#   DB_IMAGE="mongo:7.0"
# Examples (service name - auto-detects image):
#   DB_IMAGE="postgres"      # Uses image from prod_postgres container
#   DB_IMAGE="mysql"         # Uses image from prod_mysql container
#   DB_IMAGE="mongo"         # Uses image from prod_mongo container

# Docker network to use for host connections (optional)
# Default: host
DB_NETWORK="host"
# Examples:
#   DB_NETWORK="host"          # Use host network
#   DB_NETWORK="bridge"        # Use default bridge
#   DB_NETWORK="my_network"    # Use custom network
#   DB_NETWORK=""              # No network flag (use container default)

# -----------------------------------------------------------------------------
# DATABASE CREDENTIALS (used for both connection types)
# -----------------------------------------------------------------------------
DB_USER="app_user"
DB_PASSWORD="CHANGE_ME_PROD_PASSWORD"
DB_NAME="app_db"

# -----------------------------------------------------------------------------
# EXAMPLES FOR OTHER DATABASES
# -----------------------------------------------------------------------------
# For MySQL (Docker):
#   BACKUP_DATABASE="mysql"
#   CONNECTION_TYPE="docker"
#   CONTAINER="prod_mysql"
#   DB_PORT="3306"
#
# For MySQL (Host):
#   BACKUP_DATABASE="mysql"
#   CONNECTION_TYPE="host"
#   DB_HOST="mysql.production.example.com"
#   DB_PORT="3306"
#
# For MongoDB (Docker):
#   BACKUP_DATABASE="mongo"
#   CONNECTION_TYPE="docker"
#   CONTAINER="prod_mongo"
#   DB_PORT="27017"
#
# For MongoDB (Host):
#   BACKUP_DATABASE="mongo"
#   CONNECTION_TYPE="host"
#   DB_HOST="mongo.production.example.com"
#   DB_PORT="27017"
