# =============================================================================
# LARAVEL BACKEND ENVIRONMENT CONFIGURATION
# Client: {{CLIENT_NAME}} | Generated: {{TIMESTAMP}}
# =============================================================================

APP_NAME="{{CLIENT_NAME}}"
APP_ENV=production
APP_KEY={{LARAVEL_APP_KEY}}
APP_DEBUG=false
APP_URL=https://api.{{CLIENT_NAME}}.com

# Database (MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE={{CLIENT_NAME}}_db
DB_USERNAME={{CLIENT_NAME}}_user
DB_PASSWORD={{DB_PASSWORD}}

# Redis
REDIS_HOST=redis
REDIS_PASSWORD={{REDIS_PASSWORD}}
REDIS_PORT=6379
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# Mail (internal SMTP relay — see env/client/.env.infra.smtp)
MAIL_MAILER=smtp
MAIL_HOST=smtp
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@{{CLIENT_NAME}}.com
MAIL_FROM_NAME="${APP_NAME}"

# Security
JWT_SECRET={{JWT_SECRET}}
CORS_ALLOWED_ORIGINS=https://{{CLIENT_NAME}}.com
