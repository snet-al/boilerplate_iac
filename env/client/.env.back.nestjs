# =============================================================================
# NESTJS BACKEND ENVIRONMENT CONFIGURATION
# Client: {{CLIENT_NAME}} | Generated: {{TIMESTAMP}}
# =============================================================================

NODE_ENV=production
PORT=3000
APP_NAME={{CLIENT_NAME}}-api

# PostgreSQL
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME={{CLIENT_NAME}}_db
DATABASE_USER={{CLIENT_NAME}}_user
DATABASE_PASSWORD={{DB_PASSWORD}}

# MongoDB
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE={{CLIENT_NAME}}_docs
MONGO_PASSWORD={{MONGO_PASSWORD}}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{REDIS_PASSWORD}}

# Security
JWT_SECRET={{JWT_SECRET}}
API_KEY={{API_KEY}}
