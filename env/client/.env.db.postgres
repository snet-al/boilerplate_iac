POSTGRES_DB={{CLIENT_NAME}}_db
POSTGRES_USER={{CLIENT_NAME}}_user
POSTGRES_PASSWORD={{POSTGRES_PASSWORD}}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://{{CLIENT_NAME}}_user:{{POSTGRES_PASSWORD}}@postgres:5432/{{CLIENT_NAME}}_db
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD={{DB_PASSWORD}}
POSTGRES_REPLICATION_SLOT=secondary_slot
POSTGRES_PRIMARY_HOST={{PRIMARY_POSTGRES_HOST}}
POSTGRES_PRIMARY_PORT=5432
POSTGRES_SECONDARY_HOST={{SECONDARY_POSTGRES_HOST}}
