# =============================================================================
# NEXT.JS FRONTEND ENVIRONMENT CONFIGURATION
# Client: {{CLIENT_NAME}} | Generated: {{TIMESTAMP}}
# =============================================================================

NEXT_PUBLIC_APP_NAME={{CLIENT_NAME}}
NEXT_PUBLIC_APP_URL=https://{{CLIENT_NAME}}.com
NEXT_PUBLIC_API_URL=https://api.{{CLIENT_NAME}}.com
NODE_ENV=production

# Auth
NEXTAUTH_URL=https://{{CLIENT_NAME}}.com
NEXTAUTH_SECRET={{NEXTAUTH_SECRET}}
JWT_SECRET={{JWT_SECRET}}

# Internal API
API_URL_INTERNAL=http://nestjs:3000
DATABASE_URL=postgresql://{{CLIENT_NAME}}_user:{{DB_PASSWORD}}@postgres:5432/{{CLIENT_NAME}}_db
REDIS_URL=redis://:{{REDIS_PASSWORD}}@redis:6379

NEXT_TELEMETRY_DISABLED=1
